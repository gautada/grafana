#!/bin/sh
# ╭――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――╮
# │ GRAFANA - S6 SERVICE SCRIPT                                              │
# ╰――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――╯
# This script is an s6 service run script that launches and manages the
# Grafana server within the container.

APP_USER="grafana"
CONFIG_FILE="/etc/grafana/grafana.ini"
HOME_PATH="/usr/share/grafana"
DATA_PATH="/var/lib/grafana"
LOG_PATH="/var/log/grafana"
PLUGINS_PATH="/var/lib/grafana/plugins"
PROVISIONING_PATH="/etc/grafana/provisioning"

# Ensure runtime directories exist and have correct ownership.
mkdir -p "${DATA_PATH}" "${LOG_PATH}" "${PLUGINS_PATH}"
chown -R "${APP_USER}:${APP_USER}" "${DATA_PATH}" "${LOG_PATH}"

exec s6-setuidgid "${APP_USER}" \
  /usr/sbin/grafana-server \
    --config="${CONFIG_FILE}" \
    --homepath="${HOME_PATH}" \
    --packaging=container \
    cfg:default.paths.data="${DATA_PATH}" \
    cfg:default.paths.logs="${LOG_PATH}" \
    cfg:default.paths.plugins="${PLUGINS_PATH}" \
    cfg:default.paths.provisioning="${PROVISIONING_PATH}"
